FROM python:3.12-slim
WORKDIR /app
COPY multijugador/ /app/multijugador/
COPY Hitboxes/Mapas/ /app/Hitboxes/Mapas/
# Árbol de clasificación compartido con el modo de un jugador (sin Pygame).
COPY logica/__init__.py logica/Arboles.py /app/logica/
RUN pip install --no-cache-dir -r /app/multijugador/requirements.txt
ENV PYTHONUNBUFFERED=1
ENV PORT=10000
EXPOSE 10000
USER 10001
CMD ["python", "-m", "multijugador.servicio_internet"]
