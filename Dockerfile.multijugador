FROM python:3.12-slim
WORKDIR /app
COPY multijugador/ /app/multijugador/
COPY Hitboxes/ /app/Hitboxes/
# Árbol de clasificación compartido con el modo de un jugador (sin Pygame).
COPY logica/ /app/logica/
COPY datos/ /app/datos/
# Bots de relleno de las salas (sin Pygame).
COPY bots/ /app/bots/
RUN pip install --no-cache-dir -r /app/multijugador/requirements.txt
ENV PYTHONUNBUFFERED=1
ENV PORT=10000
EXPOSE 10000
USER 10001
CMD ["python", "-m", "multijugador.servicio_internet"]
